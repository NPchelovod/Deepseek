<Window x:Class="OllamaChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ollama Chat" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Область чата -->
        <TextBox x:Name="ChatBox" Grid.Row="0" IsReadOnly="True" 
                 VerticalScrollBarVisibility="Auto" Margin="5" 
                 FontFamily="Consolas" FontSize="14"/>

        <!-- Панель ввода -->
        <DockPanel Grid.Row="1" Margin="5">
            <Button Content="Загрузить файлы" DockPanel.Dock="Left" 
                    Click="LoadFilesButton_Click" Margin="0,0,5,0" Padding="5"/>
            <Button Content="Отправить" DockPanel.Dock="Right" 
                    Click="SendButton_Click" Margin="5,0,0,0" Padding="10,5"/>
            <TextBox x:Name="InputBox" 
                     AcceptsReturn="False" 
                     TextWrapping="Wrap" 
                     VerticalContentAlignment="Center"
                     KeyDown="InputBox_KeyDown"/>
        </DockPanel>
    </Grid>
</Window>