<Window x:Class="OllamaChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ollama Chat" Height="520" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Область чата -->
        <TextBox x:Name="ChatBox" Grid.Row="0" IsReadOnly="True" 
                 VerticalScrollBarVisibility="Auto" Margin="5" 
                 FontFamily="Consolas" FontSize="14"
                 TextWrapping="Wrap" AcceptsTab="True"/>

        <!-- Панель ввода (основная) -->
        <DockPanel Grid.Row="1" Margin="5">
            <CheckBox x:Name="UseContextCheckBox" Content="Использовать контекст" 
                      DockPanel.Dock="Left" VerticalAlignment="Center" 
                      Checked="UseContextCheckBox_Changed" Unchecked="UseContextCheckBox_Changed"
                      Margin="0,0,10,0"/>

            <Button Content="Загрузить папку" DockPanel.Dock="Left" 
                    Click="LoadFolderButton_Click" Margin="0,0,5,0" Padding="5"/>

            <Button Content="Отправить" DockPanel.Dock="Right" 
                    Click="SendButton_Click" Margin="5,0,0,0" Padding="10,5"/>

            <TextBox x:Name="InputBox" 
                     AcceptsReturn="False" 
                     TextWrapping="Wrap" 
                     VerticalContentAlignment="Center"
                     KeyDown="InputBox_KeyDown"
                     MinWidth="200"/>
        </DockPanel>

        <!-- Новая панель настроек (Grid.Row="2") -->
        <Border Grid.Row="2" Background="#F5F5F5" Padding="10" Margin="5" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Колонка 0: Растягивается, забирает всё лишнее место -->
                    <ColumnDefinition Width="*"/>
                    <!-- Колонка 1: Фиксированная под цифры -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Колонка 2: Фиксированная под галочку -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 1. Модель ИИ (слева, занимает всё свободное место) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                    <TextBlock Text="Модель ИИ:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ModelComboBox" MinWidth="150" Margin="0,2,0,2" VerticalAlignment="Center">
                        <ComboBoxItem Content="llama3.1" IsSelected="True"/>
                        <ComboBoxItem Content="mistral"/>
                        <ComboBoxItem Content="gemma3"/>
                    </ComboBox>
                </StackPanel>

                <!-- 2. Макс. токенов (справа от модели, фиксированный блок) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="1" Margin="20,0,10,0">
                    <TextBlock Text="Макс. токенов:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="MaxTokensTextBox" Width="80" VerticalAlignment="Center"
                     Text="4096" TextAlignment="Right"
                     PreviewTextInput="MaxTokensTextBox_PreviewTextInput"/>
                </StackPanel>

                <!-- 3. Галочка "Я главный" (край справа, никогда не наедет) -->
                <CheckBox x:Name="IsAdminCheckBox" Grid.Column="2" Content="Я главный пользователь" 
                  VerticalAlignment="Center" HorizontalAlignment="Right"
                  Checked="IsAdminCheckBox_Changed" Unchecked="IsAdminCheckBox_Changed"/>
            </Grid>
        </Border>
    </Grid>
</Window>
